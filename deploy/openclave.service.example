# systemd unit template. The README ("Keep it running") fills in the
# __USER__, __HOME__, __REPO__ and __DATA__ values with one sed command; or copy it to
# /etc/systemd/system/openclave.service and replace them by hand, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now openclave
# Bind address and port come from __DATA__/openclave.toml ([network]).
[Unit]
Description=OpenClave personal agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
Environment=OPENCLAVE_HOME=__DATA__
# API keys and tokens (ANTHROPIC_API_KEY, XAI_API_KEY, ...). OpenClave also
# reads this file itself; the leading "-" makes it optional.
EnvironmentFile=-__DATA__/.env
# The CLI routes (claude, codex) are usually installed in ~/.local/bin.
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__REPO__/.venv/bin/python run.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
